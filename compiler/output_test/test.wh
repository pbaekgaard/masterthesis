fn main() -> si32 {
    si32 ptc;
    si32 authenticated;
    si32 cardPin1;
    si32 cardPin2;
    si32 cardPin3;
    si32 cardPin4;
    si32 userPin1;
    si32 userPin2;
    si32 userPin3;
    si32 userPin4;
    si32 pinsEqual;
    si32 x;
    ui32 step_counter;
    step_counter = (0 as ui32);
    ptc = (3 as si32);
    step_counter++;
    if (step_counter != (1 as ui32)) {
        return (77 as si32);
    }
    authenticated = (0 as si32);
    step_counter++;
    if (step_counter != (2 as ui32)) {
        return (77 as si32);
    }
    cardPin1 = (1 as si32);
    step_counter++;
    if (step_counter != (3 as ui32)) {
        return (77 as si32);
    }
    cardPin2 = (2 as si32);
    step_counter++;
    if (step_counter != (4 as ui32)) {
        return (77 as si32);
    }
    cardPin3 = (3 as si32);
    step_counter++;
    if (step_counter != (5 as ui32)) {
        return (77 as si32);
    }
    cardPin4 = (4 as si32);
    step_counter++;
    if (step_counter != (6 as ui32)) {
        return (77 as si32);
    }
    userPin1 = (0 as si32);
    step_counter++;
    if (step_counter != (7 as ui32)) {
        return (77 as si32);
    }
    userPin2 = (0 as si32);
    step_counter++;
    if (step_counter != (8 as ui32)) {
        return (77 as si32);
    }
    userPin3 = (0 as si32);
    step_counter++;
    if (step_counter != (9 as ui32)) {
        return (77 as si32);
    }
    userPin4 = (0 as si32);
    step_counter++;
    if (step_counter != (10 as ui32)) {
        return (77 as si32);
    }
    pinsEqual = (0 as si32);
    step_counter++;
    if (step_counter != (11 as ui32)) {
        return (77 as si32);
    }
    x = (1 as si32);
    step_counter++;
    if (step_counter != (12 as ui32)) {
        return (77 as si32);
    }
    if ( ptc > (0 as si32)) {
        step_counter++;
        if (step_counter != (13 as ui32)) {
            return (77 as si32);
        }
        if ( userPin1 == cardPin1) {
            step_counter++;
            if (step_counter != (14 as ui32)) {
                return (77 as si32);
            }
            pinsEqual = pinsEqual + (1 as si32);
            step_counter++;
            if (step_counter != (15 as ui32)) {
                return (77 as si32);
            }
            step_counter = (13 as ui32);
        }
        if ( userPin2 != cardPin2) {
            step_counter++;
            if (step_counter != (14 as ui32)) {
                return (77 as si32);
            }
            pinsEqual = pinsEqual + (1 as si32);
            step_counter++;
            if (step_counter != (15 as ui32)) {
                return (77 as si32);
            }
            step_counter = (13 as ui32);
        }
        if ( userPin3 != cardPin3) {
            step_counter++;
            if (step_counter != (14 as ui32)) {
                return (77 as si32);
            }
            pinsEqual = pinsEqual + (1 as si32);
            step_counter++;
            if (step_counter != (15 as ui32)) {
                return (77 as si32);
            }
            step_counter = (13 as ui32);
        }
        if ( userPin4 != cardPin4) {
            step_counter++;
            if (step_counter != (14 as ui32)) {
                return (77 as si32);
            }
            pinsEqual = pinsEqual + (1 as si32);
            step_counter++;
            if (step_counter != (15 as ui32)) {
                return (77 as si32);
            }
            step_counter = (13 as ui32);
        }
        if ( pinsEqual == (4 as si32)) {
            step_counter++;
            if (step_counter != (14 as ui32)) {
                return (77 as si32);
            }
            ptc = (3 as si32);
            step_counter++;
            if (step_counter != (15 as ui32)) {
                return (77 as si32);
            }
            authenticated = (1 as si32);
            step_counter++;
            if (step_counter != (16 as ui32)) {
                return (77 as si32);
            }
            step_counter = (13 as ui32);
        }
        step_counter++;
        if (step_counter != (14 as ui32)) {
            return (77 as si32);
        }
        else {
            ptc = ptc - (1 as si32);
            step_counter++;
            if (step_counter != (15 as ui32)) {
                return (77 as si32);
            }
            step_counter = (13 as ui32);
        }
        step_counter = (12 as ui32);
    }
    return (authenticated as si32);
}

main();
