#!/bin/bash

# 1. Check if a filename was provided
if [ -z "$1" ]; then
    echo "Usage: $0 <filename.s>"
    exit 1
fi

INPUT_FILE=$1
BASE_NAME="${INPUT_FILE%.*}"
echo "INPUT=$INPUT_FILE"
echo "BASE_NAME=$BASE_NAME"
ARM_AS=/usr/bin/arm-none-eabi-as
ARM_LD=/usr/bin/arm-none-eabi-ld

"$ARM_AS" -mthumb -o "$BASE_NAME.o" "$INPUT_FILE" || exit 2
"$ARM_LD" -o "$BASE_NAME" "$BASE_NAME.o" || exit 3

# 3. Run and capture the exit code
echo "--- Running $BASE_NAME ---"
qemu-arm "./$BASE_NAME"

# Store the exit code of the PREVIOUS command (qemu-arm)
EXIT_STATUS=$?

# 4. Cleanup
rm "$BASE_NAME.o" "$BASE_NAME"

# 5. Exit with the captured status
echo "--- Finished with code: $EXIT_STATUS ---"
exit $EXIT_STATUS
