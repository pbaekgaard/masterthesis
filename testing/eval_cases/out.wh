ui32 res;
ui32 stmt;
ui32 bit_shift;
ui32 flip_mask;

fn main(ui32 stmt, ui32 flip_mask) -> ui32 {
    ui32 publicN;
    ui32 secretP;
    ui32 secretQ;
    ui32 qInvModP;
    ui32 sigP;
    ui32 sigQ;
    ui32 diff;
    ui32 intermediate;
    ui32 loopActive;
    ui32 finalSignature;
    publicN = (77 as ui32);
    if (stmt == (0 as ui32)) {
        publicN = (77 as ui32) ^ flip_mask;
    }
    secretP = (7 as ui32);
    if (stmt == (1 as ui32)) {
        secretP = (7 as ui32) ^ flip_mask;
    }
    secretQ = (11 as ui32);
    if (stmt == (2 as ui32)) {
        secretQ = (11 as ui32) ^ flip_mask;
    }
    qInvModP = (2 as ui32);
    if (stmt == (3 as ui32)) {
        qInvModP = (2 as ui32) ^ flip_mask;
    }
    sigP = (3 as ui32);
    if (stmt == (4 as ui32)) {
        sigP = (3 as ui32) ^ flip_mask;
    }
    sigQ = (5 as ui32);
    if (stmt == (5 as ui32)) {
        sigQ = (5 as ui32) ^ flip_mask;
    }
    diff = sigP - sigQ;
    if (stmt == (6 as ui32)) {
        diff = sigP - sigQ ^ flip_mask;
    }
    intermediate = diff * qInvModP;
    if (stmt == (7 as ui32)) {
        intermediate = diff * qInvModP ^ flip_mask;
    }
    loopActive = (1 as ui32);
    if (stmt == (8 as ui32)) {
        loopActive = (1 as ui32) ^ flip_mask;
    }
    if ( intermediate < secretP) {
        loopActive = (0 as ui32);
        if (stmt == (9 as ui32)) {
            loopActive = (0 as ui32) ^ flip_mask;
        }
    }
    if ( intermediate == secretP) {
        intermediate = (0 as ui32);
        if (stmt == (10 as ui32)) {
            intermediate = (0 as ui32) ^ flip_mask;
        }
        loopActive = (0 as ui32);
        if (stmt == (11 as ui32)) {
            loopActive = (0 as ui32) ^ flip_mask;
        }
    }
    if ( intermediate < (0 as ui32)) {
        intermediate = intermediate + secretP;
        if (stmt == (12 as ui32)) {
            intermediate = intermediate + secretP ^ flip_mask;
        }
    }
    if ( loopActive == (1 as ui32)) {
        intermediate = intermediate - secretP;
        if (stmt == (13 as ui32)) {
            intermediate = intermediate - secretP ^ flip_mask;
        }
    }
    finalSignature = sigQ + secretQ * intermediate;
    if (stmt == (14 as ui32)) {
        finalSignature = sigQ + secretQ * intermediate ^ flip_mask;
    }
    return (finalSignature as ui32);
}
stmt = (? as ui32);
bit_shift = (? as ui32);
assume (bit_shift <= (31 as ui32));
assume (bit_shift >= (0 as ui32));
assume (stmt >= (0 as ui32));
assume (stmt <= (14 as ui32));
flip_mask = ((1 as ui32) << bit_shift);

res = main(stmt, flip_mask);
assert(res == (0 as ui32));
