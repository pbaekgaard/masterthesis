#!/bin/python3

import argparse, os, toml, shutil, subprocess, sys
import matplotlib.pyplot as plt
from datetime import datetime
from src.database import ResultsDatabase
from src.testrunner import TestRunner
from src.symexrunner import SymexRunner
from src.plotenator import Plotter
from rich.console import Console


class Experiment:
    def __init__(self, args, run_variants, config_path=None):
        if config_path is None:
            config_path = os.path.join(os.path.dirname(__file__), "config.toml")

        with open(config_path, "r") as f:
            config = toml.load(f)
        self.args = args
        self.run_variants = run_variants
        self.base_dir = os.path.dirname(__file__)
        self.tests_folder = os.path.join(
            self.base_dir, config.get("test_folder", "fissc")
        )
        self.artifacts_folder = os.path.join(self.base_dir, "artifacts")
        self.plot_mode = config.get("plotmode", "save")
        self.injection_points = config.get(
            "injection_points",
            [
                "r0",
                "r1",
                "r2",
                "r3",
                "r4",
                "r5",
                "r6",
                "r7",
                "r8",
                "r9",
                "r10",
                "r11",
                "r12",
            ],
        )
        self.default_pass_mode = config.get("pass_mode", {}).get(
            "default", "returncode"
        )
        self.pass_mode_configs = config.get("pass_mode", {})
        self.runner = TestRunner(config_path=args.config)
        self.tests = self.runner._discover_tests()
        self.compile_results = None

    def run(self):

        # check that the compiler and interpreter is present:
        self.runner.check_bin()

        print(f"Setting up...")
        folder = self.setup()
        print(f"Created folder: {folder}")

        print(f"\nCompiling tests...")
        results = self.runner.compile()
        print(f"Compiled {len(results)} tests")
        all_fault_results = None
        wh_files = sorted(
            [f for f in os.listdir(self.runner.compiled_folder) if f.endswith(".wh")]
        )

        print("Whiley Files are ready for adding fault injections...")
        print("\nRunning symex...")
        symex_runner = SymexRunner(config_path=self.args.config)
        symex_runner.artifacts_folder = self.runner.compiled_folder
        symex_results = symex_runner.run(self.run_variants)

        self.db.insert_symex_results_batch(self.run_id, symex_results)

        if not self.args.skip_run:
            print(f"\nRunning interpreter ...")
            exhaustive_fault_results = self.runner.run_tests(
                limit=self.args.limit, run_variants=run_variants
            )
            guided_fault_results = self.runner.run_tests(limit=self.args.limit, run_variants=run_variants, minimc_res=symex_results)
        else:
            print(f"\nSkipping test run (--skip-run)")

        self.db.insert_interpreter_results_batch(self.run_id, exhaustive_fault_results)
        self.db.insert_interpreter_results_batch(self.run_id, guided_fault_results, True)

        plotter = Plotter(self.db)
        plots = plotter.create_plots()

        print("Running plots...")

        plots_dir = os.path.join(self.run_folder, "plots")
        os.makedirs(plots_dir, exist_ok=True)


        def save_plot(name, fig):
            """Handles the saving of the figure to a specific directory."""
            path = os.path.join(plots_dir, f"{name}.svg")
            fig.savefig(path, format="svg", bbox_inches="tight")

        def show_plot(fig):
            """Handles the rendering and cleanup of the figure."""
            plt.figure(fig.number)
            plt.show()
            plt.close(fig)



        # only these remain as plots
        if self.plot_mode == "save" or self.plot_mode == "both":
            save_plot("exhaustive", plots["exhaustive"])
            save_plot("guided", plots["guided"])

        if self.plot_mode == "show" or self.plot_mode == "both":
            show_plot(plots["exhaustive"])
            show_plot(plots["guided"])


        # NEW: symex exported as CSV instead of plot
        symex_csv_path = os.path.join(plots_dir, "symex_results.csv")
        plotter.export_symex_csv(symex_csv_path)

        self.db.close()
        
        zip_base = os.path.join(self.artifacts_folder, self.run_name)
        shutil.make_archive(
            zip_base, "zip", self.artifacts_folder, self.run_folder_name
        )
        shutil.rmtree(self.run_folder)

        print(f"\nArtifacts saved to: {zip_base}.zip")

    def setup(self):
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        run_num = self._get_next_run_number()
        self.run_name = f"{run_num}-{timestamp}"
        self.run_folder_name = f"test_results"
        self.run_folder = os.path.join(self.artifacts_folder, self.run_folder_name)
        self.run_tests_folder = os.path.join(self.run_folder, "tests")
        self.runner.compiled_folder = os.path.join(
            self.run_folder, "compiled_test_files"
        )
        db_path = os.path.join(self.run_folder, "results.db")

        os.makedirs(self.run_folder, exist_ok=True)
        os.makedirs(self.run_tests_folder, exist_ok=True)
        os.makedirs(self.runner.compiled_folder, exist_ok=True)

        for f in os.listdir(self.tests_folder):
            if f.endswith(".trv") or f.endswith(".trv.output") or f.endswith(".wh"):
                shutil.copy(os.path.join(self.tests_folder, f), self.run_tests_folder)

        self.db = ResultsDatabase(db_path)
        self.run_id = self.db.create_run(run_num, self.tests_folder)

        return self.run_folder

    def _get_next_run_number(self):
        if not os.path.exists(self.artifacts_folder):
            return 1

        max_num = 0
        for item in os.listdir(self.artifacts_folder):
            base_name = item[:-4] if item.endswith(".zip") else item
            if os.path.isdir(
                os.path.join(self.artifacts_folder, item)
            ) or item.endswith(".zip"):
                parts = base_name.split("-", 1)
                if len(parts) == 2 and parts[0].isdigit():
                    max_num = max(max_num, int(parts[0]))
        return max_num + 1


def run_setup(target="all", force=False):
    script_dir = os.path.dirname(os.path.abspath(__file__))
    setup_module = os.path.join(script_dir, "src", "setup.py")

    cmd = [sys.executable, setup_module, "--target", target]
    if force:
        cmd.append("-f")

    result = subprocess.run(cmd)
    return result.returncode


def get_missing_binaries():
    script_dir = os.path.dirname(os.path.abspath(__file__))
    bin_dir = os.path.join(script_dir, "bin")
    required_bins = ["minimc", "compiler", "interpreter"]
    missing = []
    for bin_name in required_bins:
        if not os.path.isfile(os.path.join(bin_dir, bin_name)):
            missing.append(bin_name)
    return missing


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", type=str, default=None, help="Path to config.toml")
    parser.add_argument(
        "--setup",
        type=str,
        nargs="?",
        const="all",
        default=None,
        metavar="TARGETS",
        help="Only run setup (build dependencies), then quit. Comma-separated: compiler, interpreter, minimc, or all",
    )
    parser.add_argument(
        "--skip-run",
        action="store_true",
        help="Only setup and compile, skip running tests",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=None,
        help="Limit number of injection points to test",
    )
    parser.add_argument(
        "--nohard",
        action="store_true",
        help="Skip hardened version when running tests",
    )
    parser.add_argument("--hard", action="store_true", help="Only run hardened version")
    args, unknown = parser.parse_known_args()

    force = "-f" in unknown or "--reinit" in unknown

    if args.setup:
        exit(run_setup(target=args.setup, force=force))

    missing_bins = get_missing_binaries()
    if missing_bins:
        print(f"\033[91mError: Binaries not found: {', '.join(missing_bins)}\033[0m")
        if len(missing_bins) > 1:
            print("Run 'test --setup' to compile the binaries")
            exit(1)
        print("Run 'test --setup' to compile the binary")
        exit(1)


    if args.nohard and args.hard:
        print("Error: Cannot use both --nohard and --hard")
        exit()

    if args.hard:
        run_variants = "hard"
    elif args.nohard:
        run_variants = "normal"
    else:
        run_variants = "both"
    exp = Experiment(args, run_variants)
    exp.run()
