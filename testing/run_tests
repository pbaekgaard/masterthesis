            config_path = os.path.join(os.path.dirname(__file__), "config.toml")

        with open(config_path, "r") as f:
            config = toml.load(f)
        self.args = args
        self.run_variants = run_variants
        self.base_dir = os.path.dirname(__file__)
        self.tests_folder = os.path.join(
            self.base_dir, config.get("test_folder", "fissc")
        )
        self.artifacts_folder = os.path.join(self.base_dir, "artifacts")
        self.plot_mode = config.get("plotmode", "save")
        self.runner = TestRunner(config_path=args.config, oracle=pinny_check_passed)
        self.tests = self.runner._discover_tests()
        self.compile_results = None

    def _build_stmt_to_trv_mapping(self, wh_path, trv_path):
        """Build a mapping from stmt numbers to .trv file lines."""
        import re
        stmt_to_expr = {}
        
        if not os.path.exists(wh_path) or not os.path.exists(trv_path):
            return stmt_to_expr
        
        with open(wh_path, 'r') as f:
            wh_lines = f.readlines()
        
        for i, line in enumerate(wh_lines):
            match = re.search(r'if\s*\(stmt\s*==\s*\((\d+)\s+as\s+ui32\)\)', line)
            if match:
                stmt_num = int(match.group(1))
                if i > 0:
                    prev_line = wh_lines[i-1].strip().rstrip(';')
                    expr_match = re.match(r'(\w+)\s*=\s*(.+)', prev_line)
                    if expr_match:
                        var_name = expr_match.group(1)
                        rhs = expr_match.group(2).strip()
                        rhs_normalized = re.sub(r'\s*\(?\d+\s+as\s+ui32\)?', lambda m: re.search(r'\d+', m.group()).group(), rhs)
                        stmt_to_expr[stmt_num] = (var_name, rhs_normalized)
        
        with open(trv_path, 'r') as f:
            trv_lines = f.readlines()
        
        stmt_to_trv_line = {}
        used_trv_lines = set()
        
        for stmt_num, (var_name, rhs_normalized) in stmt_to_expr.items():
            best_match = None
            for line_idx, trv_line in enumerate(trv_lines):
                if line_idx in used_trv_lines:
                    continue
                stripped = trv_line.strip().rstrip(';')
                
                trv_expr_match = re.match(r'(?:let\s+)?(\w+)\s*(?::\s*\w+\s*)?=\s*(.+)', stripped)
                if trv_expr_match:
                    trv_var = trv_expr_match.group(1)
                    trv_rhs = trv_expr_match.group(2).strip()
                    
                    if trv_var == var_name:
                        if rhs_normalized == trv_rhs:
                            best_match = (line_idx + 1, stripped)
                            break
                        elif best_match is None and re.search(re.escape(var_name), trv_rhs):
                            best_match = (line_idx + 1, stripped)
            
            if best_match:
                stmt_to_trv_line[stmt_num] = best_match
                used_trv_lines.add(best_match[0] - 1)
        
        return stmt_to_trv_line

    def _run_edited_tests(self, edited_trv_path, test_name):
        """Compile and run symex + fault injection on an edited .trv file."""
        edited_folder = os.path.join(self.run_folder, "edited_test_files")
        os.makedirs(edited_folder, exist_ok=True)
        
        print(f"\n{'='*60}")
        print(f"RE-RUNNING ANALYSIS ON EDITED FILE: {os.path.basename(edited_trv_path)}")
        print(f"{'='*60}")
        
        edited_test_name = os.path.splitext(os.path.basename(edited_trv_path))[0]
        
        edited_test = {
            "name": edited_test_name,
            "path": edited_trv_path,
            "expected_output": "",
            "pass_mode": {"mode": "returncode", "expected_pass": 0, "expected_fail": 1},
        }
        
        orig_tests = self.runner.tests
        orig_compile_results = self.runner.compile_results
        orig_compiled_folder = self.runner.compiled_folder
        
        self.runner.tests = [edited_test]
        self.runner.compile_results = None
        self.runner.compiled_folder = edited_folder
        
        print(f"\nCompiling edited test...")
        compile_results = self.runner.compile()
        for res in compile_results:
            if res["normal"] and res["normal"]["success"]:
                print(f"  Compiled successfully: {res['normal']['asm_path']}")
            else:
                print(f"  Compilation failed!")
                if res["normal"] and res["normal"]["stderr"]:
                    print(f"    stderr: {res['normal']['stderr']}")
                self.runner.tests = orig_tests
                self.runner.compile_results = orig_compile_results
                self.runner.compiled_folder = orig_compiled_folder
                return
        
        print(f"\nRunning symex on edited file...")
        symex_runner = SymexRunner(config_path=self.args.config)
        symex_runner.artifacts_folder = edited_folder
        edited_symex_results = symex_runner.run("normal")
        
        self.db.insert_symex_results_batch(self.run_id, edited_symex_results, edited=True)
        print(edited_symex_results)
        
        print(f"\nRunning Interpreter Guided on edited file...")
        guided_results = self.runner.run_tests(limit=self.args.limit, run_variants="normal", minimc_res=edited_symex_results)
        
        print(f"\nRunning Interpreter Exhaustively on edited file...")
        self.runner.compile_results = None
        exhaustive_results = self.runner.run_tests(limit=self.args.limit, run_variants="normal")
        
        self.db.insert_interpreter_results_batch(self.run_id, exhaustive_results, edited=True)
        self.db.insert_interpreter_results_batch(self.run_id, guided_results, True, edited=True)
        
        print(f"\nDisplaying errors found by symex on edited file (normal variant only)...")
        print(f"{'='*60}")
        if edited_symex_results:
            normal_results = [r for r in edited_symex_results if r.get("variant") == "Normal"]
            if normal_results:
                results_by_test = {}
                for result in normal_results:
                    tname = result["test"]
                    if tname not in results_by_test:
                        results_by_test[tname] = []
                    results_by_test[tname].append(result)
                
                for tname, results in results_by_test.items():
                    print(f"\nTest: {tname}")
                    print("-" * 40)
                    for result in results:
                        stmt = result.get("stmt")
                        faulty_bit = result.get("faulty_bit")
                        variant = result.get("variant")
                        res_val = result.get("result")
                        print(f"  Stmt {stmt}: Faulty bit: {faulty_bit}, Variant: {variant}, Result: {res_val}")
            else:
                print("  No errors found by symex for normal variant.")
        else:
            print("  No errors found by symex.")
        print(f"{'='*60}")
        
        self.runner.tests = orig_tests
        self.runner.compile_results = orig_compile_results
        self.runner.compiled_folder = orig_compiled_folder
        
        return edited_symex_results, guided_results, exhaustive_results

    def run(self):

        # check that the compiler and interpreter is present:
        self.runner.check_bin()

        print(f"Setting up...")
        folder = self.setup()
        print(f"Created folder: {folder}")

        print(f"\nCompiling tests...")
        results = self.runner.compile()
        print(f"Compiled {len(results)} tests")
        all_fault_results = None
        wh_files = sorted(
            [f for f in os.listdir(self.runner.compiled_folder) if f.endswith(".wh")]
        )

        print("Whiley Files are ready for adding fault injections...")
        print("\nRunning symex...")
        symex_runner = SymexRunner(config_path=self.args.config)
        symex_runner.artifacts_folder = self.runner.compiled_folder
        symex_results = symex_runner.run(self.run_variants)

        self.db.insert_symex_results_batch(self.run_id, symex_results)

        if not self.args.skip_run:
            print(f"\nRunning Interpreter Guided...")
            guided_fault_results = self.runner.run_tests(limit=self.args.limit, run_variants=run_variants, minimc_res=symex_results)
            print(f"\nRunning Interpreter Exhaustively...")
            exhaustive_fault_results = self.runner.run_tests(
                limit=self.args.limit, run_variants=run_variants
            )
            self.db.insert_interpreter_results_batch(self.run_id, exhaustive_fault_results)
            self.db.insert_interpreter_results_batch(self.run_id, guided_fault_results, True)
        else:
            print(f"\nSkipping test run (--skip-run)")


        # Display errors found by symex for normal variant only
        print(f"\n{'='*60}")
        print("ERRORS FOUND BY SYMEX (Symbolic Execution) - Normal Variant Only")
        print(f"{'='*60}")
        trv_files_to_edit = set()
        if symex_results:
            normal_results = [r for r in symex_results if r.get("variant") == "Normal"]
            if normal_results:
                results_by_test = {}
                for result in normal_results:
                    test_name = result["test"]
                    if test_name not in results_by_test:
                        results_by_test[test_name] = []
                    results_by_test[test_name].append(result)
                
                for test_name, results in results_by_test.items():
                    print(f"\nTest: {test_name}")
                    print("-" * 40)
                    
                    trv_path = None
                    wh_path = None
                    for test in self.tests:
                        if test["name"] == test_name:
                            trv_path = test["path"]
                            break
                    
                    if trv_path:
                        test_base = os.path.splitext(os.path.basename(trv_path))[0]
                        wh_path = os.path.join(self.runner.compiled_folder, f"{test_base}.wh")
                        artifact_trv = os.path.join(self.run_tests_folder, f"{test_base}.trv")
                        if os.path.exists(artifact_trv):
                            trv_files_to_edit.add(artifact_trv)
                    
                    stmt_mapping = self._build_stmt_to_trv_mapping(wh_path, trv_path) if trv_path and wh_path else {}
                    
                    if trv_path and os.path.exists(trv_path):
                        for result in results:
                            stmt = result.get("stmt")
                            faulty_bit = result.get("faulty_bit")
                            variant = result.get("variant")
                            res_val = result.get("result")
                            
                            if stmt in stmt_mapping:
                                line_number, line_content = stmt_mapping[stmt]
                                print(f"  Stmt {stmt} (line {line_number}): {line_content}")
                                print(f"    -> Faulty bit: {faulty_bit}, Variant: {variant}, Result: {res_val}")
                            else:
                                print(f"  Stmt {stmt}: (could not map to source) Faulty bit: {faulty_bit}, Variant: {variant}, Result: {res_val}")
                    else:
                        print(f"  .trv file not found for test {test_name}")
                        for result in results:
                            stmt = result.get("stmt")
                            faulty_bit = result.get("faulty_bit")
                            variant = result.get("variant")
                            res_val = result.get("result")
                            print(f"  Stmt {stmt}: Faulty bit: {faulty_bit}, Variant: {variant}, Result: {res_val}")
            else:
                print("  No errors found by symex for normal variant.")
        else:
            print("  No errors found by symex.")
        print(f"{'='*60}")
        
        if trv_files_to_edit:
            editor = os.environ.get("EDITOR", "nano")
            
            known_terminals = ["foot", "alacritty", "kitty", "gnome-terminal", "xterm", "kgx", "ghostty"]
            term_cmd = None
            for t in known_terminals:
                if shutil.which(t):
                    term_cmd = t
                    break
            
            edited_files = []
            for trv_file in sorted(trv_files_to_edit):
                edited_path = trv_file.replace(".trv", ".edited.trv")
                shutil.copy2(trv_file, edited_path)
                edited_files.append(edited_path)
            
            while True:
                editor_procs = []
                for edited_file in edited_files:
                    print(f"\nOpening {edited_file} in {editor} (new terminal window)...")
                    if term_cmd:
                        if term_cmd == "kgx":
                            p = subprocess.Popen(["kgx", "--wait", "--", editor, edited_file], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        elif term_cmd == "xterm":
                            p = subprocess.Popen(["xterm", "-e", editor, edited_file], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        elif term_cmd == "konsole":
                            p = subprocess.Popen(["konsole", "-e", editor, edited_file], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        elif term_cmd in ("alacritty", "kitty", "foot", "ghostty"):
                            p = subprocess.Popen([term_cmd, "-e", editor, edited_file], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        editor_procs.append(p)
                    else:
                        print(f"  Warning: No terminal emulator found, opening in current terminal")
                        subprocess.run([editor, edited_file])
                
                for p in editor_procs:
                    p.wait()
                
                while True:
                    try:
                        response = input("\nHave you made the edits you wanted? (y/n): ").strip().lower()
                        if response in ("y", "n"):
                            break
                    except EOFError:
                        response = "y"
                        break
                
                if response == "y":
                    break
            
            print(f"\n{'='*60}")
            print("Compiling and re-running analysis on edited files...")
            print(f"{'='*60}")
            
            for edited_file in edited_files:
                test_base = os.path.splitext(os.path.basename(edited_file))[0].replace(".edited", "")
                self._run_edited_tests(edited_file, test_base)



        plotter = Plotter(self.db)
        plots = plotter.create_plots()


        plots_dir = os.path.join(self.run_folder, "plots")
        os.makedirs(plots_dir, exist_ok=True)


        def save_plot(name, fig):
            """Handles the saving of the figure to a specific directory."""
            path = os.path.join(plots_dir, f"{name}.svg")
            fig.savefig(path, format="svg", bbox_inches="tight")

        # only these remain as plots
        if self.plot_mode == "save" or self.plot_mode == "both":
            print("Saving Plots...")
            save_plot("exhaustive", plots["exhaustive"])
            save_plot("exhaustive_edited", plots["exhaustive_edited"])
            save_plot("guided", plots["guided"])
            save_plot("guided_edited", plots["guided_edited"])
            save_plot("exhaustive_fault_types_normal", plots["exhaustive_fault_types_normal"])
            save_plot("exhaustive_fault_types_hard", plots["exhaustive_fault_types_hard"])
            save_plot("exhaustive_fault_types_normal_edited", plots["exhaustive_fault_types_normal_edited"])
            save_plot("guided_fault_types_normal", plots["guided_fault_types_normal"])
            save_plot("guided_fault_types_hard", plots["guided_fault_types_hard"])
            save_plot("guided_fault_types_normal_edited", plots["guided_fault_types_normal_edited"])

        if self.plot_mode == "show" or self.plot_mode == "both":
            print("Showing Plots...")
            plt.show()
            for fig in plots.values():
                plt.close(fig)

        # symex exported as CSV instead of plot
        symex_csv_path = os.path.join(plots_dir, "symex_results.csv")
        plotter.export_symex_csv(symex_csv_path)

        self.db.close()

        prompt = f"Name for artifact zip (default: {self.run_name}): "
        try:
            name = input(prompt).strip()
        except EOFError:
            name = ""
        if not name:
            name = self.run_name

        zip_base = os.path.join(self.artifacts_folder, name)
        temp_name = os.path.join(self.artifacts_folder, "test_results")
        os.rename(self.run_folder, temp_name)
        shutil.make_archive(
            zip_base, "zip", self.artifacts_folder, "test_results"
        )
        shutil.rmtree(temp_name)

        print(f"\nArtifacts saved to: {zip_base}.zip")

    def setup(self):
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        run_num = self._get_next_run_number()
        self.run_name = f"{run_num}-{timestamp}"
        self.run_folder_name = f"test_results-{self.run_name}"
        self.run_folder = os.path.join(self.artifacts_folder, self.run_folder_name)
        self.run_tests_folder = os.path.join(self.run_folder, "tests")
        self.runner.compiled_folder = os.path.join(
            self.run_folder, "compiled_test_files"
        )
        db_path = os.path.join(self.run_folder, "results.db")

        os.makedirs(self.run_folder, exist_ok=True)
        os.makedirs(self.run_tests_folder, exist_ok=True)
        os.makedirs(self.runner.compiled_folder, exist_ok=True)

        for f in os.listdir(self.tests_folder):
            if f.endswith(".trv") or f.endswith(".trv.output") or f.endswith(".wh"):
                shutil.copy(os.path.join(self.tests_folder, f), self.run_tests_folder)

        self.db = ResultsDatabase(db_path)
        self.run_id = self.db.create_run(run_num, self.tests_folder)

        return self.run_folder

    def _get_next_run_number(self):
        if not os.path.exists(self.artifacts_folder):
            return 1

        max_num = 0
        for item in os.listdir(self.artifacts_folder):
            base_name = item[:-4] if item.endswith(".zip") else item
            if os.path.isdir(
                os.path.join(self.artifacts_folder, item)
            ) or item.endswith(".zip"):
                parts = base_name.split("-", 1)
                if len(parts) == 2 and parts[0].isdigit():
                    max_num = max(max_num, int(parts[0]))
        return max_num + 1


def run_setup(target="all", force=False):
    script_dir = os.path.dirname(os.path.abspath(__file__))
    setup_module = os.path.join(script_dir, "src", "setup.py")

    cmd = [sys.executable, setup_module, "--target", target]
    if force:
        cmd.append("-f")

    result = subprocess.run(cmd)
    return result.returncode


def get_missing_binaries():
    script_dir = os.path.dirname(os.path.abspath(__file__))
    bin_dir = os.path.join(script_dir, "bin")
    required_bins = ["minimc", "compiler", "interpreter"]
    missing = []
    for bin_name in required_bins:
        if not os.path.isfile(os.path.join(bin_dir, bin_name)):
            missing.append(bin_name)
    return missing


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", type=str, default=None, help="Path to config.toml")
    parser.add_argument(
        "--setup",
        type=str,
        nargs="?",
        const="all",
        default=None,
        metavar="TARGETS",
        help="Only run setup (build dependencies), then quit. Comma-separated: compiler, interpreter, minimc, or all",
    )
    parser.add_argument(
        "--skip-run",
        action="store_true",
        help="Only setup and compile, skip running tests",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=None,
        help="Limit number of injection points to test",
    )
    parser.add_argument(
        "--nohard",
        action="store_true",
        help="Skip hardened version when running tests",
    )
    parser.add_argument("--hard", action="store_true", help="Only run hardened version")
    args, unknown = parser.parse_known_args()

    force = "-f" in unknown or "--reinit" in unknown

    if args.setup:
        exit(run_setup(target=args.setup, force=force))

    missing_bins = get_missing_binaries()
    if missing_bins:
        print(f"\033[91mError: Binaries not found: {', '.join(missing_bins)}\033[0m")
        if len(missing_bins) > 1:
            print("Run 'test --setup' to compile the binaries")
            exit(1)
        print("Run 'test --setup' to compile the binary")
        exit(1)


    if args.nohard and args.hard:
        print("Error: Cannot use both --nohard and --hard")
        exit()

    if args.hard:
        run_variants = "hard"
    elif args.nohard:
        run_variants = "normal"
    else:
        run_variants = "both"
    exp = Experiment(args, run_variants)
    exp.run()
