ui32 res;
ui32 stmt;
ui32 bit_shift;
ui32 flip_mask;

fn main(ui32 stmt, ui32 flip_mask) -> ui32 {
    ui32 message;
    ui32 h;
    ui32 multiplier;
    ui32 prime_modulo;
    ui32 temp_msg;
    ui32 chunk;
    message = (0 as ui32);
    if (stmt == (0 as ui32)) {
        message = (0 as ui32) ^ flip_mask;
    }
    message = (12345 as ui32) * (10000 as ui32) + (6789 as ui32);
    if (stmt == (1 as ui32)) {
        message = (12345 as ui32) * (10000 as ui32) + (6789 as ui32) ^ flip_mask;
    }
    h = (5381 as ui32);
    if (stmt == (2 as ui32)) {
        h = (5381 as ui32) ^ flip_mask;
    }
    multiplier = (33 as ui32);
    if (stmt == (3 as ui32)) {
        multiplier = (33 as ui32) ^ flip_mask;
    }
    prime_modulo = (0 as ui32);
    if (stmt == (4 as ui32)) {
        prime_modulo = (0 as ui32) ^ flip_mask;
    }
    prime_modulo = (104 as ui32) * (1000 as ui32) + (729 as ui32);
    if (stmt == (5 as ui32)) {
        prime_modulo = (104 as ui32) * (1000 as ui32) + (729 as ui32) ^ flip_mask;
    }
    temp_msg = message;
    if (stmt == (6 as ui32)) {
        temp_msg = message ^ flip_mask;
    }
    chunk = (0 as ui32);
    if (stmt == (7 as ui32)) {
        chunk = (0 as ui32) ^ flip_mask;
    }
    if ( temp_msg == (0 as ui32)) {
        temp_msg = (7 as ui32);
        if (stmt == (8 as ui32)) {
            temp_msg = (7 as ui32) ^ flip_mask;
        }
    }
    chunk = temp_msg - temp_msg / (100 as ui32) * (100 as ui32);
    if (stmt == (9 as ui32)) {
        chunk = temp_msg - temp_msg / (100 as ui32) * (100 as ui32) ^ flip_mask;
    }
    h = h * multiplier + chunk;
    if (stmt == (10 as ui32)) {
        h = h * multiplier + chunk ^ flip_mask;
    }
    h = h - h / prime_modulo * prime_modulo;
    if (stmt == (11 as ui32)) {
        h = h - h / prime_modulo * prime_modulo ^ flip_mask;
    }
    temp_msg = temp_msg / (100 as ui32);
    if (stmt == (12 as ui32)) {
        temp_msg = temp_msg / (100 as ui32) ^ flip_mask;
    }
    if ( h < (0 as ui32)) {
        h = h + prime_modulo;
        if (stmt == (13 as ui32)) {
            h = h + prime_modulo ^ flip_mask;
        }
    }
    return (h as ui32);
}
stmt = (? as ui32);
bit_shift = (? as ui32);
assume (bit_shift <= (31 as ui32));
assume (bit_shift >= (0 as ui32));
assume (stmt >= (0 as ui32));
assume (stmt <= (13 as ui32));
flip_mask = ((1 as ui32) << bit_shift);

res = main(stmt, flip_mask);
assert(res == (0 as ui32));
