#!/bin/bash

# --- Configuration ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$SCRIPT_DIR/bin"
MINIMC_DIR="$SCRIPT_DIR/../minimc"
COMPILER_DIR="$SCRIPT_DIR/../compiler"
INTERPRETER_DIR="$SCRIPT_DIR/../interpreter"

# Temporary directory for inter-process communication
TMP_DIR="/tmp/trivic_build_$(id -u)"
mkdir -p "$TMP_DIR"
echo "0" > "$TMP_DIR/mini_pct"
echo "0" > "$TMP_DIR/comp_pct"
echo "0" > "$TMP_DIR/int_pct"

# --- UI Helpers ---

# draw_line <offset_from_bottom> <percentage> <label>
draw_line() {
    local offset=$1
    local percent=$2
    local label=$3
    local filled=$((percent / 5)) # 20 char wide bar
    local empty=$((20 - filled))

    # \e[?25l: hide cursor, \e[s: save cursor, \e[nA: move up n lines, \e[K: clear line, \e[u: restore cursor
    printf "\e[?25l\e[s\e[${offset}A\e[K"
    
    # Color logic: Green if 100%, Yellow otherwise
    local color="\e[33m"
    if [ "$percent" -eq 100 ]; then color="\e[32m"; fi
    
    printf "${color}[%-20s]\e[0m %3d%% - %s" "$(printf "%${filled}s" | tr ' ' '#')" "$percent" "$label"
    printf "\e[u\e[?25h"
}

# --- Build Tasks ---

build_minimc_task() {
    # 1. Submodule Check
    if [ ! -d "$MINIMC_DIR/.git" ] || [ -z "$(ls -A "$MINIMC_DIR")" ]; then
        git submodule update --init --recursive > /dev/null 2>&1
        pushd "$MINIMC_DIR" > /dev/null
        git checkout development > /dev/null 2>&1
        git pull > /dev/null 2>&1
        popd > /dev/null
    fi

    pushd "$MINIMC_DIR" > /dev/null
    # 2. Configure
    cmake -B build -Wno-dev > /dev/null 2>&1
    
    # 3. Build & Parse Progress
    # Using stdbuf to prevent output buffering so the bar updates smoothly
    stdbuf -oL cmake --build build 2>&1 | while read -r line; do
        if [[ "$line" =~ \[[[:space:]]*([0-9]+)%\] ]]; then
            echo "${BASH_REMATCH[1]}" > "$TMP_DIR/mini_pct"
        fi
    done
    
    echo "100" > "$TMP_DIR/mini_pct"
    cp build/bin/minimc "$BIN_DIR/minimc"
    popd > /dev/null
}

build_rust_task() {
    local project_dir=$1
    local bin_out_name=$2
    local target_bin_name=$3
    local pct_file=$4

    pushd "$project_dir" > /dev/null
    echo "10" > "$pct_file"
    cargo build --release > /dev/null 2>&1
    echo "100" > "$pct_file"
    cp "target/release/$target_bin_name" "$BIN_DIR/$bin_out_name"
    popd > /dev/null
}

# --- Execution ---

# Flag Handling
FORCE=false
[[ "$1" == "-f" || "$1" == "--reinit" ]] && FORCE=true

if [ "$FORCE" = true ]; then
    rm -rf "$BIN_DIR"
    rm -rf "$COMPILER_DIR/target"
    rm -rf "$INTERPRETER_DIR/target"
    rm -rf "$MINIMC_DIR/build"
fi
mkdir -p "$BIN_DIR"

# Clear space for the 3 bars
echo -e "\033[1mInitializing Parallel Build...\033[0m"
echo "" # Placeholder for MiniMC (Line 3)
echo "" # Placeholder for Compiler (Line 2)
echo "" # Placeholder for Interpreter (Line 1)

# Start background processes
build_minimc_task & PID_MINI=$!
build_rust_task "$COMPILER_DIR" "compiler" "trivic" "$TMP_DIR/comp_pct" & PID_COMP=$!
build_rust_task "$INTERPRETER_DIR" "interpreter" "thumb2_interpreter" "$TMP_DIR/int_pct" & PID_INT=$!

# Monitor Loop
while true; do
    # Read current progress values
    P_MINI=$(cat "$TMP_DIR/mini_pct")
    P_COMP=$(cat "$TMP_DIR/comp_pct")
    P_INT=$(cat "$TMP_DIR/int_pct")

    # Update the UI
    draw_line 3 "$P_MINI" "MiniMC"
    draw_line 2 "$P_COMP" "Compiler"
    draw_line 1 "$P_INT"  "Interpreter"

    # Check if background jobs are still running
    if ! kill -0 $PID_MINI 2>/dev/null && ! kill -0 $PID_COMP 2>/dev/null && ! kill -0 $PID_INT 2>/dev/null; then
        break
    fi
    sleep 0.1
done

# Cleanup
rm -rf "$TMP_DIR"

echo -e "\n\n\e[32m✔ All tasks completed successfully!\e[0m"
echo "Binaries are available in: $BIN_DIR"
